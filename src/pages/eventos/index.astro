---
import { getCollection } from 'astro:content';

const eventosSinOrdenar = await getCollection('eventos');
const eventos = eventosSinOrdenar.sort(
  (a, b) => a.data.fecha.valueOf() - b.data.fecha.valueOf()
);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />     
    <title>Eventos</title>
  </head>
  <body>
    <h1>Próximos eventos</h1>
    <ul>
      {eventos.map((evento) => (
        <li>
          <a href={`/eventos/${evento.id}`}>
            <h2>{evento.data.titulo}</h2>
            <p>{evento.data.lugar}</p>
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>