---
import Layout from "../layouts/Layout.astro";
import Map from "../components/MapaInteractivo.astro";
---

<Layout>
    <main>
        <div class="max-w-4xl mx-auto px-4 mt-8">
            <header
                class="fixed top-0 left-0 w-full h-16 bg-blue-900 z-50 shadow-md flex items-center justify-center"
            >
                <h1
                    class="self-center text-xl font-semibold whitespace-nowrap text-white"
                >
                    Karlamaps
                </h1>
            </header>
        </div>
        <section id="mapa" class="w-full px-4 md:px-8 pt-19 mb-12">
            <div
                class="max-w-7xl mx-auto h-165 rounded-3xl overflow-hidden shadow-2xl border-4 border-white/50 bg-white"
            >
                <Map />
            </div>
        </section>

        <section
            class="bg-white max-w-4xl mx-auto min-h-screen shadow-2xl p-6 md:p-12 md:rounded-t-xl"
        >
            <div
                id="informacion-lugares"
                class="grid grid-cols-1 md:grid-cols-2 gap-6"
            >
                <article class="border rounded-lg overflow-hidden shadow-sm">
                    <img
                        src="https://picsum.photos/seed/montana/400/200"
                        alt="Lugar turístico"
                        class="w-full h-48 object-cover"
                    />
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-2">Cerro Catedral</h3>
                        <p class="text-gray-600 text-sm">
                            Lorem ipsum dolor sit amet consectetur adipisicing
                            elit.
                        </p>
                    </div>
                </article>

                <article class="border rounded-lg overflow-hidden shadow-sm">
                    <img
                        src="https://picsum.photos/seed/lugar2/400/200"
                        alt="Lugar 2"
                        class="w-full h-48 object-cover"
                    />
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-2">
                            Lugar Turístico 2
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Lorem ipsum dolor sit amet consectetur adipisicing
                            elit.
                        </p>
                    </div>
                </article>

                <article class="border rounded-lg overflow-hidden shadow-sm">
                    <img
                        src="https://picsum.photos/seed/lugar3/400/200"
                        alt="Lugar 3"
                        class="w-full h-48 object-cover"
                    />
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-2">
                            Lugar Turístico 3
                        </h3>
                        <p class="prose-slate">
                            Lorem ipsum dolor, sit amet consectetur adipisicing elit. Eligendi provident doloremque enim culpa consectetur consequatur dignissimos harum maxime, nihil sed nam quisquam cumque dolore aliquid molestias possimus modi quaerat natus.
                            elit.
                        </p>
                    </div>
                </article>
            </div>
        </section>
    </main>
</Layout>
