---
import Layout from "../layouts/Layout.astro";
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const lugares = await getCollection('lugares');
const eventos = await getCollection('eventos');

const todosLosItems = [
    ...lugares.map(lugar => ({
        id: lugar.id,
        coleccion: 'lugares',
        url: `/lugares/${lugar.id}`,
        titulo: lugar.data.nombre,
        descripcion: lugar.body,
        imagen: lugar.data.imagen
    })),
    ...eventos.map(evento => ({
        id: evento.id,
        coleccion: 'eventos',
        url: `/eventos/${evento.id}`,
        titulo: evento.data.titulo,
        descripcion: evento.body,
        imagen: evento.data.imagen
    }))
];

let destacados = todosLosItems.filter(item => {
    const tituloLower = item.titulo.toLowerCase();
    return tituloLower.includes('trekking') || 
           tituloLower.includes('chaya') || 
           tituloLower.includes('sauces');
}).slice(0, 3);

if (destacados.length === 0) {
    destacados = todosLosItems.slice(0, 3);
}
---

<Layout title="Nexotour">
    <main 
        transition:name="fondo-azul" 
        class="relative min-h-screen flex flex-col items-center justify-center py-12 px-4 overflow-hidden"
    >
        <div 
            class="absolute inset-0 bg-cover bg-center bg-no-repeat -z-20"
            style="background-image: url('/img/talampaya.png');"
        ></div>

        <div class="absolute inset-0 bg-linear-to-b from-transparent from-60% to-black to-100% -z-10"></div>

        <div class="relative z-10 w-full flex flex-col items-center">
            
            <div class="flex flex-col md:flex-row md:items-end justify-center gap-0 md:gap-0 mb-12">
                <img 
                    src="/img/logo.png" 
                    alt="Logo Nexotour" 
                    class="h-16 md:h-24 w-auto object-contain drop-shadow-lg brightness-0 invert -translate-y-0.5" 
                />
                <h1 class="text-5xl md:text-7xl font-bold text-white tracking-wide text-center drop-shadow-lg m-0">
                    Nexotour
                </h1>
            </div>

            <div class="flex flex-col items-center w-full max-w-350 mx-auto">
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full mb-12">
                    {destacados.map((item) => (
                        <a href={item.url} class="group block h-full">
                            <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-lg border border-white/20 hover:scale-105 transition-transform flex flex-col h-full">
                                
                                <div class="h-48 relative overflow-hidden bg-white/5">
                                    {item.imagen ? (
                                        <Image 
                                            src={item.imagen} 
                                            alt={item.titulo} 
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            transition:name={`img-${item.coleccion}-${item.id}`} 
                                        />
                                    ) : (
                                        <div class="w-full h-full bg-white/10"></div>
                                    )}
                                </div>
                                
                                <div class="p-5 flex flex-col grow">
                                    <h3 
                                        class="text-xl font-bold text-white mb-2"
                                        transition:name={`title-${item.coleccion}-${item.id}`}
                                    >
                                        {item.titulo}
                                    </h3>
                                    <p class="text-gray-300 text-sm line-clamp-3">
                                        {item.descripcion}
                                    </p>
                                </div>

                            </div>
                        </a>
                    ))}
                </div> 

                <div class="flex justify-center items-center">
                    <a
                        href="/explorar"
                        class="group flex flex-col md:flex-row items-center justify-center gap-3 bg-blue-600 text-white font-bold text-lg px-8 py-5 md:py-4 rounded-3xl md:rounded-full shadow-lg border border-blue-500 hover:bg-blue-700 hover:shadow-blue-900/20 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1"
                    >
                        <span>Explorar Mapa</span>
                        <svg
                            class="w-6 h-6 group-hover:animate-[doble-salto_1.5s_ease-in-out_infinite]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2.5"
                                d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
                        </svg>
                    </a>
                </div>

            </div> 
            
        </div>
    </main>
</Layout>

<style is:global>
    @keyframes doble-salto {
        0%, 60%, 100% { transform: translateY(0); }
        15% { transform: translateY(-6px); }
        30% { transform: translateY(0); }
        45% { transform: translateY(-6px); }
    }
</style>