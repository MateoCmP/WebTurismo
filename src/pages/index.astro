---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bienvenido a Web Turismo">
    <!-- Animacion con viewtransition -->
    <main 
        transition:name="fondo-azul" 
        class="min-h-screen bg-linear-to-b from-blue-900 from-70% to-black to-95% flex flex-col items-center justify-center py-12 px-4"
    >
        
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-12 tracking-wide text-center">
            Turismo Maps
        </h1>

        <!-- Eventos destacados -->
        <div class="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
            
            <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-lg border border-white/20 hover:scale-105 transition-transform">
                <img src="https://via.placeholder.com/600x300/e2e8f0/475569?text=Lugar+Destacado+1" alt="Placeholder" class="w-full h-48 object-cover" />
                <div class="p-5">
                    <h3 class="text-xl font-bold text-white mb-2">Parque Nacional Talampaya</h3>
                    <p class="text-gray-300 text-sm">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna.</p>
                </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-lg border border-white/20 hover:scale-105 transition-transform">
                <img src="https://via.placeholder.com/600x300/e2e8f0/475569?text=Lugar+Destacado+2" alt="Placeholder" class="w-full h-48 object-cover" />
                <div class="p-5">
                    <h3 class="text-xl font-bold text-white mb-2">Cuesta de Miranda</h3>
                    <p class="text-gray-300 text-sm">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
                </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-lg border border-white/20 hover:scale-105 transition-transform">
                <img src="https://via.placeholder.com/600x300/e2e8f0/475569?text=Lugar+Destacado+3" alt="Placeholder" class="w-full h-48 object-cover" />
                <div class="p-5">
                    <h3 class="text-xl font-bold text-white mb-2">Laguna Brava</h3>
                    <p class="text-gray-300 text-sm">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur.</p>
                </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-lg border border-white/20 hover:scale-105 transition-transform">
                <img src="https://via.placeholder.com/600x300/e2e8f0/475569?text=Lugar+Destacado+4" alt="Placeholder" class="w-full h-48 object-cover" />
                <div class="p-5">
                    <h3 class="text-xl font-bold text-white mb-2">Fiesta de la Chaya</h3>
                    <p class="text-gray-300 text-sm">Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
                </div>
            </div>

        </div>

        <a 
            href="/explorar" 
            class="px-8 py-4 bg-white text-blue-900 text-lg font-bold rounded-full shadow-xl hover:bg-gray-100 hover:shadow-2xl transition-all transform hover:-translate-y-1"
        >
            Explorar más
        </a>

    </main>
</Layout>