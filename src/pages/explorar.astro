---
import Layout from "../layouts/Layout.astro";
import Map from "../components/MapaInteractivo.astro";
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const lugares = await getCollection('lugares');
const eventos = await getCollection('eventos');

const itemsExplorar = [
    ...lugares.map(lugar => ({
        id: lugar.id,
        coleccion: 'lugares',
        url: `/lugares/${lugar.id}`,
        titulo: lugar.data.nombre,
        categoria: lugar.data.categoria,
        imagen: lugar.data.imagen,
        descripcion: lugar.body
    })),
    ...eventos.map(evento => ({
        id: evento.id,
        coleccion: 'eventos',
        url: `/eventos/${evento.id}`,
        titulo: evento.data.titulo,
        categoria: evento.data.categoria,
        imagen: evento.data.imagen,
        descripcion: evento.body
    }))
];
---

<Layout title="Explorar - Nexotour">
    
    <header class="fixed top-0 left-0 w-full h-16 bg-white/80 backdrop-blur-md border-b border-gray-200 z-50 shadow-sm flex items-center justify-center">
        <a href="/" class="flex items-end gap-2 hover:opacity-80 transition-opacity">
            <img src="/img/logo.png" alt="Logo Nexotour" class="h-8 w-auto object-contain" />
            <h1 class="self-center text-2xl font-bold whitespace-nowrap text-blue-900 tracking-wide translate-y-[0.5px]">
                Nexotour
            </h1>
        </a>
    </header>

    <main transition:name="fondo-azul" class="relative min-h-screen pb-12">
        
        <div 
            class="fixed inset-0 bg-cover bg-center bg-no-repeat -z-20"
            style="background-image: url('/img/talampaya.png');"
        ></div>

        <div class="relative z-10 pt-28">
            <section id="mapa" class="w-full px-4 md:px-8 mb-12">
                <div class="max-w-400 mx-auto h-165 rounded-3xl overflow-hidden shadow-2xl border-4 border-white/50 bg-white">
                    <Map />
                </div>
            </section>

            <section class="w-full max-w-400 mx-auto my-12 p-6 sm:p-10 bg-white/80 backdrop-blur-md rounded-3xl shadow-lg border border-white">
                <div class="mb-8">
                    <h2 class="text-3xl font-bold text-gray-900">
                        Descubre Destinos y Eventos
                    </h2>
                    <p class="text-gray-600 mt-2">
                        Explora los mejores lugares y las próximas actividades.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {
                        itemsExplorar.map((item) => (
                            <a href={item.url} class="group block h-full">
                                <article class="bg-white rounded-2xl border border-gray-200 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col h-full">
                                    <div class="h-48 relative overflow-hidden bg-gray-200">
                                        {item.imagen ? (
                                            <Image
                                                src={item.imagen}
                                                alt={`Imagen de ${item.titulo}`}
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                                transition:name={`img-${item.coleccion}-${item.id}`}
                                            />
                                        ) : (
                                            <div class="w-full h-full bg-linear-to-br from-blue-100 to-gray-200" />
                                        )}
                                        <div class="absolute inset-0 bg-blue-900/0 group-hover:bg-blue-900/10 transition-colors duration-300" />
                                    </div>

                                    <div class="p-6 flex flex-col grow">
                                        <span
                                            class={`text-xs font-bold uppercase tracking-wider mb-2 ${item.coleccion === "eventos" ? "text-orange-600" : "text-blue-600"}`}
                                        >
                                            {item.categoria}
                                        </span>

                                        <h3
                                            class="text-xl font-semibold text-gray-900 mb-2"
                                            transition:name={`title-${item.coleccion}-${item.id}`}
                                        >
                                            {item.titulo}
                                        </h3>

                                        <p class="text-sm text-gray-600 line-clamp-3 mb-4 grow">
                                            {item.descripcion}
                                        </p>

                                        <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
                                            <span class="text-sm font-medium text-blue-700 group-hover:text-blue-900 transition-colors">
                                                Ver detalles &rarr;
                                            </span>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        ))
                    }
                </div>
            </section>
        </div>
    </main>
</Layout>