---
import Layout from "../layouts/Layout.astro";
import Map from "../components/MapaInteractivo.astro";
import { getCollection } from "astro:content";
const lugares = await getCollection("lugares");
---

<Layout title="Explorar - Nexotour">
    <main transition:name="fondo-azul" class="relative min-h-screen pb-12">
        <div
            class="fixed inset-0 bg-cover bg-center bg-no-repeat -z-20"
            style="background-image: url('/img/talampaya.png');"
        >
        </div>

        <header
            class="fixed top-0 left-0 w-full h-16 bg-white/80 backdrop-blur-md border-b border-gray-200 z-50 shadow-sm flex items-center justify-center"
        >
            <a href="/" class="flex md:items-end gap-0 hover:opacity-80 transition-opacity">
                <img src="/img/logo.png" alt="Logo Nexotour" class="h-8 w-auto object-contain -translate-y-1" />
                
                <h1 class="self-center text-2xl font-bold whitespace-nowrap text-blue-900 tracking-wide">
                    Nexotour
                </h1>
            </a>
        </header>

        <div class="relative z-10 pt-28">
            <section id="mapa" class="w-full px-4 md:px-8 mb-12">
                <div
                    class="max-w-400 mx-auto h-165 rounded-3xl overflow-hidden shadow-2xl border-4 border-white/50 bg-white"
                >
                    <Map />
                </div>
            </section>

            <section
                class="w-full max-w-400 mx-auto my-12 p-6 sm:p-10 bg-white/80 backdrop-blur-md rounded-3xl shadow-lg border border-white"
            >
                <div class="mb-8">
                    <h2 class="text-3xl font-bold text-gray-900">
                        Lugares Destacados
                    </h2>
                    <p class="text-gray-600 mt-2">
                        Explora los puntos de interés disponibles en el mapa.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
                >
                    {
                        lugares.map((lugar) => (
                            <a
                                href={`/lugares/${lugar.id}`}
                                class="group block h-full"
                            >
                                <article class="bg-white rounded-2xl border border-gray-200 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col h-full">
                                    <div class="h-48 relative overflow-hidden bg-gray-200">
                                        {lugar.data.imagen ? (
                                            <img
                                                src={lugar.data.imagen}
                                                alt={`Imagen de ${lugar.data.nombre}`}
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                                transition:name={`img-${lugar.id}`}
                                            />
                                        ) : (
                                            <div class="w-full h-full bg-linear-to-br from-blue-100 to-gray-200" />
                                        )}
                                        <div class="absolute inset-0 bg-blue-900/0 group-hover:bg-blue-900/10 transition-colors duration-300" />
                                    </div>

                                    <div class="p-6 flex flex-col grow">
                                        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">
                                            {lugar.data.categoria}
                                        </span>

                                        <h3
                                            class="text-xl font-semibold text-gray-900 mb-2"
                                            transition:name={`title-${lugar.id}`}
                                        >
                                            {lugar.data.nombre}
                                        </h3>

                                        <p class="text-sm text-gray-600 line-clamp-3 mb-4 grow">
                                            {lugar.body}
                                        </p>

                                        <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
                                            <span class="text-sm font-medium text-blue-700 group-hover:text-blue-900 transition-colors">
                                                Ver detalles &rarr;
                                            </span>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        ))
                    }
                </div>
            </section>
        </div>
    </main>
</Layout>
