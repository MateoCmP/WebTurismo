---
import "leaflet/dist/leaflet.css";
import { obtenerPuntos } from "../lib/mapa/puntos";

const puntos = await obtenerPuntos();
---

<div id="map" class="w-full h-full z-0" data-puntos={JSON.stringify(puntos)}>
</div>

<style is:global>
  .custom-marker {
    background: transparent;
    border: none;
  }

  .marker-inner {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid white;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s ease-in-out;
  }

  .custom-marker:hover .marker-inner {
    transform: scale(1.6);
  }
</style>

<script>
  import { initMap } from "../lib/mapa/InitMapa";
  import type { PuntoMapa } from "../lib/mapa/Marcador";

  let map: ReturnType<typeof initMap> | undefined;

  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("map");
    if (!el) return;
    const puntos: PuntoMapa[] = JSON.parse(el.dataset.puntos ?? "[]");
    map = initMap("map", puntos);
  });

  document.addEventListener("astro:before-swap", () => {
    map?.remove();
    map = undefined;
  });
</script>