---
import "leaflet/dist/leaflet.css";
import MapaIsla from "./MapaIsla.vue";
import { obtenerPuntos } from "../lib/mapa/puntos";

const puntos = await obtenerPuntos();
---

<MapaIsla client:visible puntos={puntos} />

<style is:global>
  .custom-marker {
    background: transparent;
    border: none;
  }

  .marker-inner {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid white;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s ease-in-out;
  }

  .custom-marker:hover .marker-inner {
    transform: scale(1.6);
  }
</style>
