<div id="map"></div>

<style>
  #map {
    width: 100%;
    height: 500px;
  }

  .custom-marker {
    background: transparent;
    border: none;
  }

  .marker-inner {
    width: 24px;
    height: 24px;
    background: #e63946;
    border-radius: 50%;
    border: 2px solid white;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s ease-in-out;
  }

  .custom-marker:hover .marker-inner {
    transform: scale(1.6);
  }
</style>

<script>
  import { initMap } from "../lib/mapa/InitMapa";

  initMap("map");
</script>
